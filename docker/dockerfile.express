FROM oven/bun:1

WORKDIR /app

COPY package.json bun.lock ./
#will change it later
COPY backend/package.json ./backend/
COPY websocket/package.json ./websocket/
COPY worker/package.json ./worker/
COPY pg-db/package.json ./pg-db/
COPY redis-db/package.json ./redis-db/

RUN bun install --frozen-lockfile

COPY backend ./backend
COPY pg-db ./pg-db
COPY redis-db ./redis-db

WORKDIR /app/pg-db
# prisma's bin is linked into pg-db/node_modules/.bin (isolated install), and
# prisma.config.ts resolves DATABASE_URL at load time - the dummy value is
# only to satisfy that, generate never connects to the database.
RUN DATABASE_URL="postgresql://user:pass@localhost:5432/db" bunx --bun prisma generate
WORKDIR /app/backend

EXPOSE 8080

CMD ["bun", "run", "start"]